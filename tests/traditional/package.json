{
  "name": "techmart-tests",
  "version": "1.0.0",
  "description": "Traditional test suite for TechMart demo app",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:only-edge-cases": "playwright test tests/edge-cases.spec.js",
    "test:install-browsers": "playwright install"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.42.0"
  }
}
